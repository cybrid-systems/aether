; lib/aether-min.aura — Closed-loop facade (Axes A + B + F)
;
; (require "aether-min" all:)
;
; Thin re-export of axis modules (H3/H4 extract landed):
;   aether-measure       Axis F — stats / alist-ref
;   aether-mutate-policy Axis B — install / safety / rebind
;   aether-loop          Axis A — observe / decide / verify
;   aether-loop-once     Axis A — loop-once (sole large export)
;
; Host: loop-once must stay a single-export module (H3). Stats live in
; aether-measure and survive rebind on current host (H4 improved).

(export aether:install-source
        aether:stats aether:stats-reset! aether:stats-ref aether:stats-bump!
        aether:stats-alist aether:alist-ref
        aether:safety-ok? aether:snapshot aether:restore aether:rebind-safe
        aether:observe aether:decide aether:verify
        aether:loop-once aether:min-version)

(require "aether-measure" all:)
(require "aether-mutate-policy" all:)
(require "aether-loop" all:)
(require "aether-loop-once" all:)

(define aether:min-version 3)
