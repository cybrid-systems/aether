; examples/01-single-loop/main.aura
;
; Phase 1 denseness probe — self-evolving closed loop (no LLM).
; Thin demo over (require "aether-min" all:).
;
; Axes: A (loop) + B (mutation policy) + F (metrology)
;
; Scenario:
;   score starts as (* x 2); goal is triple (* x 3).
;   R1: observe wrong → mutate → verify → commit
;   R2: already correct → skip
;   R3: bad proposal → verify fail → rollback → still triple
;
; Run: ./scripts/run-aura.sh examples/01-single-loop/main.aura

(require "aether-min" all:)

(aether:stats-reset!)

(display "=== Aether 01-single-loop: self-evolving closed loop ===")
(newline)

(define installed
  (aether:install-source "(define score (lambda (x) (* x 2)))"))

(if (not installed)
  (begin
    (display "FAIL: could not install subject source")
    (newline)
    (display "RESULT fail example=01-single-loop")
    (newline))
  (begin
    (display "installed score = double; goal = triple")
    (newline)
    (display "R1 observe score(7)=")
    (display (score 7))
    (display " (want 21)")
    (newline)

    ; ── Round 1: commit ──
    (define r1
      (aether:loop-once
        (lambda () (score 7))
        (lambda () (not (= (score 7) 21)))
        "score"
        "(lambda (x) (* x 3))"
        "r1-to-triple"
        (lambda () (= (score 7) 21))))

    (display "R1 result: ")
    (write r1)
    (newline)
    (display "R1 score(7)=")
    (display (score 7))
    (newline)

    ; ── Round 2: skip ──
    (define r2
      (aether:loop-once
        (lambda () (score 7))
        (lambda () (not (= (score 7) 21)))
        "score"
        "(lambda (x) (* x 3))"
        "r2-noop"
        (lambda () (= (score 7) 21))))

    (display "R2 result: ")
    (write r2)
    (newline)
    (display "R2 score(7)=")
    (display (score 7))
    (newline)

    ; ── Round 3: force bad mutate → rollback ──
    (define r3
      (aether:loop-once
        (lambda () (score 7))
        (lambda () #t)
        "score"
        "(lambda (x) (* x 99))"
        "r3-bad-proposal"
        (lambda () (= (score 7) 21))))

    (display "R3 result: ")
    (write r3)
    (newline)
    (display "R3 score(7) after rollback=")
    (display (score 7))
    (newline)

    (display "stats: ")
    (write (aether:stats-alist))
    (newline)
    (display "boundary/quota ok: ")
    (display (aether:safety-ok?))
    (newline)

    (define r1-ok
      (and (aether:alist-ref ":ok" r1 #f)
           (eq? (aether:alist-ref ":decision" r1 #f) 'commit)
           (= (score 7) 21)))
    (define r2-ok
      (and (aether:alist-ref ":ok" r2 #f)
           (eq? (aether:alist-ref ":decision" r2 #f) 'skip)
           (= (score 7) 21)))
    (define r3-ok
      (and (not (aether:alist-ref ":ok" r3 #t))
           (eq? (aether:alist-ref ":decision" r3 #f) 'rollback)
           (= (score 7) 21)))

    (define all-ok
      (and r1-ok r2-ok r3-ok
           (aether:safety-ok?)
           (= (aether:stats-ref "commits") 1)
           (>= (aether:stats-ref "rollbacks") 1)
           (>= (aether:stats-ref "decide-skip") 1)
           (= (aether:stats-ref "rounds") 3)
           (= (aether:stats-ref "escapes") 0)))

    (if all-ok
      (begin
        (display "PASS: O→D→M→V→R closed loop (commit + skip + rollback)")
        (newline)
        (display "escapes: 0 in evolvable core (pure Aura + aether-min)")
        (newline)
    (display "RESULT pass example=01-single-loop escapes=0")
    (newline))
      (begin
        (display "FAIL: closed-loop checks did not all pass")
        (newline)
        (display "  r1-ok=")
        (display r1-ok)
        (display " r2-ok=")
        (display r2-ok)
        (display " r3-ok=")
        (display r3-ok)
        (newline)
        (display "  commits=")
        (display (aether:stats-ref "commits"))
        (display " rollbacks=")
        (display (aether:stats-ref "rollbacks"))
        (display " skip=")
        (display (aether:stats-ref "decide-skip"))
        (newline)))))
