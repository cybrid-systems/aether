; examples/09-live-minimax/main.aura
; Live MiniMax-M3 propose edge (aether-domain).
;
;   source ./scripts/env-minimax.sh
;   ./scripts/run-aura.sh examples/09-live-minimax/main.aura

(require "std/list" all:)
(require "aether-min" all:)
(require "aether-domain" all:)
(require "aether-propose" all:)

(aether:stats-reset!)

(display "=== Aether 09-live-minimax: MiniMax-M3 propose edge ===")
(newline)

(define key (getenv "LLM_API_KEY"))
(define base (getenv "LLM_BASE_URL"))
(define model (getenv "LLM_MODEL"))

(display "mode=")
(display (aether:propose-mode))
(display " model=")
(display (if (string? model) model "?"))
(display " base=")
(display (if (string? base) base "?"))
(display " key?")
(display (and (string? key) (> (string-length key) 0)))
(newline)

(if (or (void? key) (not (string? key)) (= (string-length key) 0))
  (begin
    (display "FAIL: LLM_API_KEY not set (source scripts/env-minimax.sh)")
    (newline)
    (display "RESULT fail example=09-live-minimax reason=no-key")
    (newline))
  (begin
    (define installed (aether:gate-install-strict))

    (display "R0 batch=")
    (display (aether:gate-run-batch))
    (newline)

    (define p1 #f)
    (define r1 #f)
    (define p1-src #f)
    (define p1-esc 0)
    (define p2 #f)
    (define r2 #f)
    (define final-batch #f)
    (define fc 99)
    (define safe #f)

    (set! p1 (aether:propose (aether:gate-fail-count) 4 "auto"))
    (set! p1-src (aether:proposal-source p1))
    (set! p1-esc (aether:stats-ref "escapes"))
    (display "P1=")
    (write p1)
    (newline)
    (display "P1-src=")
    (display p1-src)
    (display " P1-esc=")
    (display p1-esc)
    (newline)

    (set! r1
      (aether:execute-proposal
        p1
        (lambda () (aether:gate-fail-count))
        (lambda () #t)
        aether:gate-within-budget?))
    (display "P1-exec=")
    (write r1)
    (newline)
    (display "P1-batch=")
    (display (aether:gate-run-batch))
    (newline)

    (set! p2 (aether:propose (aether:gate-fail-count) 4 "auto"))
    (set! r2
      (aether:execute-proposal
        p2
        (lambda () (aether:gate-fail-count))
        (lambda () (not (aether:gate-within-budget?)))
        aether:gate-within-budget?))
    (display "P2=")
    (write p2)
    (newline)
    (display "P2-exec=")
    (write r2)
    (newline)
    (display "P2-batch=")
    (display (aether:gate-run-batch))
    (newline)

    (set! final-batch (aether:gate-run-batch))
    (set! fc (car (cdr final-batch)))
    (set! safe (aether:safety-ok?))
    (display "final-batch=")
    (display final-batch)
    (display " fc=")
    (display fc)
    (display " safe=")
    (display safe)
    (newline)

    (if (and installed
             (number? p1-esc)
             (> p1-esc 0)
             (equal? p1-src "llm-live")
             (number? fc)
             (<= fc 4)
             safe)
      (begin
        (display "PASS: MiniMax-M3 live propose edge (E>=1; core guarded)")
        (newline)
        (display "RESULT pass example=09-live-minimax live_escapes=1")
        (newline))
      (begin
        (display "FAIL")
        (newline)
        (display "RESULT fail example=09-live-minimax")
        (newline)
        (display (list p1-esc p1-src fc safe final-batch))
        (newline)))))
