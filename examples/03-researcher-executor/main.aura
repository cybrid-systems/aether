; examples/03-researcher-executor/main.aura
; Dual-role: researcher propose + executor guard (uses aether-domain).
; Run: ./scripts/run-aura.sh examples/03-researcher-executor/main.aura

(require "std/list" all:)
(require "aether-min" all:)
(require "aether-domain" all:)

(aether:stats-reset!)

(display "=== Aether 03-researcher-executor: dual-role closed loop ===")
(newline)

(define installed (aether:gate-install-strict))
(display "installed=")
(display installed)
(display " gate=")
(display (list (gate 3) (gate 4) (gate 7)))
(newline)

; Researcher: propose edge only. Returns (list kind name body summary).
(define (researcher-propose fails mode)
  (if (equal? mode "deny-all")
    (list "mutate" "gate" aether:gate-body-deny "research-deny-all")
    (if (> fails 4)
      (list "mutate" "gate" aether:gate-body-widen "research-auto-widen")
      (list "skip" "gate" "" "research-auto-noop"))))

(define (executor-run kind name body summary)
  (if (equal? kind "skip")
    (aether:loop-once
      (lambda () (aether:gate-fail-count))
      (lambda () #f)
      "gate"
      aether:gate-body-widen
      "exec-skip"
      aether:gate-within-budget?)
    (aether:loop-once
      (lambda () (aether:gate-fail-count))
      (lambda () #t)
      name
      body
      summary
      aether:gate-within-budget?)))

(display "R0 batch=")
(display (aether:gate-run-batch))
(display " fails=")
(display (aether:gate-fail-count))
(newline)

(define p1 #f)
(define r1 #f)
(define p2 #f)
(define r2 #f)
(define p3 #f)
(define r3 #f)

(set! p1 (researcher-propose (aether:gate-fail-count) "auto"))
(display "R1 proposal=")
(write p1)
(newline)
(set! r1 (executor-run (car p1) (car (cdr p1)) (car (cdr (cdr p1))) (car (cdr (cdr (cdr p1))))))
(display "R1 exec=")
(write r1)
(newline)
(display "R1 batch=")
(display (aether:gate-run-batch))
(newline)

(set! p2 (researcher-propose (aether:gate-fail-count) "auto"))
(display "R2 proposal=")
(write p2)
(newline)
(set! r2 (executor-run (car p2) (car (cdr p2)) (car (cdr (cdr p2))) (car (cdr (cdr (cdr p2))))))
(display "R2 exec=")
(write r2)
(newline)

(set! p3 (researcher-propose (aether:gate-fail-count) "deny-all"))
(display "R3 proposal=")
(write p3)
(newline)
(set! r3 (executor-run (car p3) (car (cdr p3)) (car (cdr (cdr p3))) (car (cdr (cdr (cdr p3))))))
(display "R3 exec=")
(write r3)
(newline)
(display "R3 batch=")
(display (aether:gate-run-batch))
(newline)

(display "stats ")
(write (aether:stats-alist))
(newline)

(define all-ok
  (and (equal? (car p1) "mutate")
       (equal? (car p2) "skip")
       (equal? (car p3) "mutate")
       (eq? (aether:alist-ref ":decision" r1 #f) 'commit)
       (eq? (aether:alist-ref ":decision" r2 #f) 'skip)
       (eq? (aether:alist-ref ":decision" r3 #f) 'rollback)
       (aether:gate-within-budget?)
       (= (aether:gate-fail-count) 4)
       (= (aether:stats-ref "commits") 1)
       (>= (aether:stats-ref "rollbacks") 1)
       (>= (aether:stats-ref "decide-skip") 1)
       (= (aether:stats-ref "rounds") 3)
       (aether:safety-ok?)
       (= (aether:stats-ref "escapes") 0)))

(if all-ok
  (begin
    (display "PASS: dual-role loop (researcher propose + executor guard)")
    (newline)
    (display "escapes: 0 core; propose edge pure-Aura (LLM optional, not required)")
    (newline)
    (display "RESULT pass example=03-researcher-executor escapes=0")
    (newline))
  (begin
    (display "FAIL")
    (newline)
    (display "RESULT fail example=03-researcher-executor")
    (newline)))
