; examples/05-long-run-denseness/main.aura
; Multi-round deploy / skip / poison+heal (aether-domain).
; Run: ./scripts/run-aura.sh examples/05-long-run-denseness/main.aura

(require "std/list" all:)
(require "aether-min" all:)
(require "aether-domain" all:)

(aether:stats-reset!)

(display "=== Aether 05-long-run-denseness: multi-round harness ===")
(newline)

(define last-good-body aether:gate-body-widen)
(define heals 0)
(define poisons 0)
(define deploys 0)
(define skips 0)

(define installed (aether:gate-install-strict))

(display "R0 batch=")
(display (aether:gate-run-batch))
(newline)

(define r0 #f)
(define r3h #f)
(define r7h #f)

(set! r0
  (aether:loop-once
    (lambda () (aether:gate-fail-count))
    (lambda () #t)
    "gate"
    aether:gate-body-widen
    "r0-widen"
    aether:gate-within-budget?))
(set! deploys (+ deploys 1))
(set! last-good-body aether:gate-body-widen)
(display "r0=")
(write r0)
(display " batch=")
(display (aether:gate-run-batch))
(newline)

(aether:loop-once
  (lambda () (aether:gate-fail-count))
  (lambda () #f)
  "gate" last-good-body "r1-skip" aether:gate-within-budget?)
(set! skips (+ skips 1))
(display "r1 skip batch=")
(display (aether:gate-run-batch))
(newline)

(aether:loop-once
  (lambda () (aether:gate-fail-count))
  (lambda () #f)
  "gate" last-good-body "r2-skip" aether:gate-within-budget?)
(set! skips (+ skips 1))
(display "r2 skip")
(newline)

(aether:rebind-safe "gate" aether:gate-body-deny "r3-poison")
(set! poisons (+ poisons 1))
(display "r3 after poison fails=")
(display (aether:gate-fail-count))
(newline)
(set! r3h
  (aether:loop-once
    (lambda () (aether:gate-fail-count))
    (lambda () #t)
    "gate" last-good-body "r3-heal" aether:gate-within-budget?))
(set! heals (+ heals 1))
(display "r3 heal=")
(write r3h)
(display " batch=")
(display (aether:gate-run-batch))
(newline)

(aether:loop-once
  (lambda () (aether:gate-fail-count))
  (lambda () #f)
  "gate" last-good-body "r4-skip" aether:gate-within-budget?)
(set! skips (+ skips 1))
(aether:loop-once
  (lambda () (aether:gate-fail-count))
  (lambda () #f)
  "gate" last-good-body "r5-skip" aether:gate-within-budget?)
(set! skips (+ skips 1))
(aether:loop-once
  (lambda () (aether:gate-fail-count))
  (lambda () #f)
  "gate" last-good-body "r6-skip" aether:gate-within-budget?)
(set! skips (+ skips 1))

(aether:rebind-safe "gate" aether:gate-body-deny "r7-poison")
(set! poisons (+ poisons 1))
(set! r7h
  (aether:loop-once
    (lambda () (aether:gate-fail-count))
    (lambda () #t)
    "gate" last-good-body "r7-heal" aether:gate-within-budget?))
(set! heals (+ heals 1))
(display "r7 heal=")
(write r7h)
(display " batch=")
(display (aether:gate-run-batch))
(newline)

(aether:loop-once
  (lambda () (aether:gate-fail-count))
  (lambda () #f)
  "gate" last-good-body "r8-skip" aether:gate-within-budget?)
(set! skips (+ skips 1))
(aether:loop-once
  (lambda () (aether:gate-fail-count))
  (lambda () #f)
  "gate" last-good-body "r9-skip" aether:gate-within-budget?)
(set! skips (+ skips 1))

(display "final batch=")
(display (aether:gate-run-batch))
(newline)
(display "deploys=")
(display deploys)
(display " skips=")
(display skips)
(display " poisons=")
(display poisons)
(display " heals=")
(display heals)
(newline)
(display "loop-stats ")
(write (aether:stats-alist))
(newline)

(define all-ok
  (and installed
       (aether:gate-within-budget?)
       (= (aether:gate-fail-count) 4)
       (>= deploys 1)
       (>= heals 2)
       (>= poisons 2)
       (>= skips 6)
       (eq? (aether:alist-ref ":decision" r0 #f) 'commit)
       (eq? (aether:alist-ref ":decision" r3h #f) 'commit)
       (eq? (aether:alist-ref ":decision" r7h #f) 'commit)
       (aether:safety-ok?)
       (= (aether:stats-ref "escapes") 0)
       (>= (aether:stats-ref "rounds") 10)))

(if all-ok
  (begin
    (display "PASS: long-run denseness harness (deploy/skip/poison-heal x2)")
    (newline)
    (display "escapes: 0; business fail-count within budget at end")
    (newline)
    (display "RESULT pass example=05-long-run-denseness escapes=0")
    (newline)
    (display "DENSENESS_SUMMARY deploys=")
    (display deploys)
    (display " heals=")
    (display heals)
    (display " skips=")
    (display skips)
    (display " commits=")
    (display (aether:stats-ref "commits"))
    (display " rollbacks=")
    (display (aether:stats-ref "rollbacks"))
    (newline))
  (begin
    (display "FAIL")
    (newline)
    (display "RESULT fail example=05-long-run-denseness")
    (newline)))
