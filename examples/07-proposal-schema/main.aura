; examples/07-proposal-schema/main.aura
; Schema gate before mutate (aether-domain + aether-propose).
; Run: ./scripts/run-aura.sh examples/07-proposal-schema/main.aura

(require "std/list" all:)
(require "aether-min" all:)
(require "aether-domain" all:)
(require "aether-propose" all:)

(aether:stats-reset!)

(display "=== Aether 07-proposal-schema: validate before mutate ===")
(newline)

(define installed (aether:gate-install-strict))

(display "R0 batch=")
(display (aether:gate-run-batch))
(newline)

(define p-ok #f)
(define r-ok #f)
(set! p-ok (aether:propose-rule (aether:gate-fail-count) 4 "auto"))
(display "A valid?=")
(display (aether:proposal-valid? p-ok))
(display " errors=")
(write (aether:proposal-errors p-ok))
(newline)
(set! r-ok
  (aether:execute-proposal
    p-ok
    (lambda () (aether:gate-fail-count))
    (lambda () #t)
    aether:gate-within-budget?))
(display "A exec=")
(write r-ok)
(newline)
(display "A batch=")
(display (aether:gate-run-batch))
(newline)

(define a-ok
  (and (aether:proposal-valid? p-ok)
       (eq? (aether:alist-ref ":decision" r-ok #f) 'commit)
       (aether:gate-within-budget?)))

(define p-bad-kind
  (list "explode" "gate" aether:gate-body-widen "evil" "adversary"))
(define r-bad-kind #f)
(define fails-before-b (aether:gate-fail-count))
(set! r-bad-kind
  (aether:execute-proposal
    p-bad-kind
    (lambda () (aether:gate-fail-count))
    (lambda () #t)
    aether:gate-within-budget?))
(display "B schema refuse=")
(write r-bad-kind)
(newline)
(display "B fails unchanged?=")
(display (= (aether:gate-fail-count) fails-before-b))
(newline)

(define b-ok
  (and (not (aether:proposal-valid? p-bad-kind))
       (eq? (aether:alist-ref ":decision" r-bad-kind #f) 'refuse)
       (equal? (aether:alist-ref ":reason" r-bad-kind "") "schema-invalid")
       (= (aether:gate-fail-count) fails-before-b)))

(define p-bad-body
  (list "mutate" "gate" "DELETE FROM gates" "sql-injection" "adversary"))
(define r-bad-body #f)
(set! r-bad-body
  (aether:execute-proposal
    p-bad-body
    (lambda () (aether:gate-fail-count))
    (lambda () #t)
    aether:gate-within-budget?))
(display "C bad-body refuse=")
(write r-bad-body)
(newline)

(define c-ok
  (and (not (aether:proposal-valid? p-bad-body))
       (eq? (aether:alist-ref ":decision" r-bad-body #f) 'refuse)
       (aether:gate-within-budget?)))

(define p-deny
  (list "mutate" "gate" aether:gate-body-deny "deny-all" "adversary"))
(define r-deny #f)
(set! r-deny
  (aether:execute-proposal
    p-deny
    (lambda () (aether:gate-fail-count))
    (lambda () #t)
    aether:gate-within-budget?))
(display "D semantic-bad exec=")
(write r-deny)
(newline)
(display "D batch=")
(display (aether:gate-run-batch))
(newline)

(define d-ok
  (and (aether:proposal-valid? p-deny)
       (eq? (aether:alist-ref ":decision" r-deny #f) 'rollback)
       (aether:gate-within-budget?)
       (= (aether:gate-fail-count) 4)))

(display "stats ")
(write (aether:stats-alist))
(newline)

(define all-ok
  (and installed a-ok b-ok c-ok d-ok
       (aether:safety-ok?)
       (= (aether:stats-ref "escapes") 0)))

(if all-ok
  (begin
    (display "PASS: proposal schema gate (invalid refuse; bad semantics rollback)")
    (newline)
    (display "escapes: 0; unstructured proposals never rebind")
    (newline)
    (display "RESULT pass example=07-proposal-schema escapes=0")
    (newline))
  (begin
    (display "FAIL")
    (newline)
    (display "RESULT fail example=07-proposal-schema")
    (newline)))
