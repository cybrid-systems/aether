; examples/22-overnight-mutate/main.aura
; Phase 5 / issue #4: multi-agent sandbox fanout stress (overnight driver).
;
; AETHER_OVERNIGHT_AGENTS = N (default 6; harness ramps 2→max then backoffs).
; Live: aether:fanout (parallel preferred). Offline: fanout-with-yield.
; Single mutator; poison rollback always exercised.
;
; Run: AETHER_OVERNIGHT_AGENTS=12 ./scripts/run-aura.sh examples/22-overnight-mutate/main.aura
; Overnight: ./scripts/overnight-mutate.sh

(require "std/list" all:)
(require "aether-min" all:)
(require "aether-domain" all:)
(require "aether-propose" all:)
(require "aether-orch" all:)

(aether:stats-reset!)

(display "=== Aether 22-overnight-mutate: multi-agent fanout stress ===")
(newline)
(display "LOG_META example=22-overnight-mutate role=overnight-driver denseness=phase5")
(newline)

(define pm (aether:propose-mode))
(define key (getenv "LLM_API_KEY"))
(define use-live #f)
(define agents-env (getenv "AETHER_OVERNIGHT_AGENTS"))
(define n-agents 6)
(define n-parsed #f)
(define installed #f)
(define commits 0)
(define skips 0)
(define rollbacks 0)
(define refuses 0)
(define anomalies 0)
(define fan-rounds 0)
(define total-props 0)
(define all-ok #f)
(define fails-now 0)
(define fan #f)
(define mode #f)
(define props #f)
(define yields #f)
(define picked #f)
(define exec-r #f)
(define dec #f)
(define esc0 0)
(define esc1 0)

(set! use-live
  (and (equal? pm "live")
       (string? key)
       (> (string-length key) 0)))

(if (and (string? agents-env) (> (string-length agents-env) 0))
  (begin
    (set! n-parsed (string->number agents-env))
    (if (and (number? n-parsed) (>= n-parsed 1) (<= n-parsed 32))
      (set! n-agents n-parsed)
      #f))
  #f)

; Builders — call only after install (host closure validity).
(define (repeat-live n)
  (if (or (not (number? n)) (<= n 0))
    (quote ())
    (cons (lambda (f)
            (aether:stats-bump! "escapes")
            (aether:propose f 4 "auto"))
          (repeat-live (- n 1)))))

(define (repeat-stub n)
  (if (or (not (number? n)) (<= n 0))
    (quote ())
    (cons (lambda (f)
            (aether:stats-bump! "escapes")
            (if (> f 4)
              (list "mutate" "gate" "(lambda (x) (< x 7))" "stub-widen" "llm-stub")
              (if (> f 3)
                (list "mutate" "gate" "(lambda (x) (< x 7))" "stub-eager" "llm-stub")
                (list "skip" "gate" "" "stub-skip" "llm-stub"))))
          (repeat-stub (- n 1)))))

; Append one rogue every 3rd agent for arbiter filter stress (stub only).
(define (repeat-stub-mix n i)
  (if (or (not (number? n)) (<= n 0))
    (quote ())
    (cons
      (if (= (modulo i 3) 2)
        (lambda (f)
          (aether:stats-bump! "escapes")
          (list "mutate" "gate" "(lambda (x) #f)" "stub-rogue" "llm-stub-rogue"))
        (lambda (f)
          (aether:stats-bump! "escapes")
          (if (> f 4)
            (list "mutate" "gate" "(lambda (x) (< x 7))" "stub-widen" "llm-stub")
            (list "skip" "gate" "" "stub-skip" "llm-stub"))))
      (repeat-stub-mix (- n 1) (+ i 1)))))

(define (run-fanout-live n)
  (aether:fanout (repeat-live n) (aether:gate-fail-count)))

(define (run-fanout-stub n)
  (aether:fanout-with-yield (repeat-stub-mix n 0) (aether:gate-fail-count)))

(display "n-agents=")
(display n-agents)
(display " propose-mode=")
(display pm)
(display " live?=")
(display use-live)
(display " fanout-mode(pre)=")
(display (aether:fanout-mode))
(newline)
(display "LOG_CFG agents=")
(display n-agents)
(display " live=")
(display use-live)
(display " propose_mode=")
(display pm)
(newline)

(set! installed (aether:gate-install-strict))
(display "R0 batch=")
(display (aether:gate-run-batch))
(display " fails=")
(display (aether:gate-fail-count))
(newline)

; ── macro-style top-level wave (no helper set! — host residual) ──
; Wave 0 stress
(set! fails-now (aether:gate-fail-count))
(set! esc0 (aether:stats-ref "escapes"))
(if use-live
  (set! fan (run-fanout-live n-agents))
  (set! fan (run-fanout-stub n-agents)))
(set! mode (car fan))
(set! props (car (cdr fan)))
(set! yields (car (cdr (cdr fan))))
(set! esc1 (aether:stats-ref "escapes"))
(set! total-props (+ total-props (length props)))
(set! fan-rounds (+ fan-rounds 1))
(set! picked (aether:arbitrate props (aether:gate-within-budget?)))
(set! exec-r
  (aether:execute-proposal
    picked
    (lambda () (aether:gate-fail-count))
    (lambda () #t)
    aether:gate-within-budget?))
(set! dec (aether:alist-ref ":decision" exec-r #f))
(if (eq? dec 'commit) (set! commits (+ commits 1))
  (if (eq? dec 'skip) (set! skips (+ skips 1))
    (if (eq? dec 'rollback) (set! rollbacks (+ rollbacks 1))
      (if (eq? dec 'refuse) (set! refuses (+ refuses 1))
        (set! anomalies (+ anomalies 1))))))
(display "W0 kind=stress mode=")
(display mode)
(display " n=")
(display (length props))
(display " esc+")
(display (- esc1 esc0))
(display " decision=")
(display dec)
(display " fails=")
(display (aether:gate-fail-count))
(newline)
(display "WAVE id=0 kind=stress agents=")
(display n-agents)
(display " mode=")
(display mode)
(display " n=")
(display (length props))
(display " yields=")
(display yields)
(display " esc_delta=")
(display (- esc1 esc0))
(display " decision=")
(display dec)
(display " fails=")
(display (aether:gate-fail-count))
(display " picked=")
(write picked)
(newline)

; Wave 1 healthy
(set! fails-now (aether:gate-fail-count))
(set! esc0 (aether:stats-ref "escapes"))
(if use-live
  (set! fan (run-fanout-live n-agents))
  (set! fan (run-fanout-stub n-agents)))
(set! mode (car fan))
(set! props (car (cdr fan)))
(set! yields (car (cdr (cdr fan))))
(set! esc1 (aether:stats-ref "escapes"))
(set! total-props (+ total-props (length props)))
(set! fan-rounds (+ fan-rounds 1))
(set! picked (aether:arbitrate props (aether:gate-within-budget?)))
(set! exec-r
  (aether:execute-proposal
    picked
    (lambda () (aether:gate-fail-count))
    (lambda () #f)
    aether:gate-within-budget?))
(set! dec (aether:alist-ref ":decision" exec-r #f))
(if (eq? dec 'commit) (set! commits (+ commits 1))
  (if (eq? dec 'skip) (set! skips (+ skips 1))
    (if (eq? dec 'rollback) (set! rollbacks (+ rollbacks 1))
      (if (eq? dec 'refuse) (set! refuses (+ refuses 1))
        (set! anomalies (+ anomalies 1))))))
(display "WAVE id=1 kind=healthy agents=")
(display n-agents)
(display " mode=")
(display mode)
(display " n=")
(display (length props))
(display " esc_delta=")
(display (- esc1 esc0))
(display " decision=")
(display dec)
(display " fails=")
(display (aether:gate-fail-count))
(display " picked=")
(write picked)
(newline)

; Wave 2 stress
(set! fails-now (aether:gate-fail-count))
(set! esc0 (aether:stats-ref "escapes"))
(if use-live
  (set! fan (run-fanout-live n-agents))
  (set! fan (run-fanout-stub n-agents)))
(set! mode (car fan))
(set! props (car (cdr fan)))
(set! yields (car (cdr (cdr fan))))
(set! esc1 (aether:stats-ref "escapes"))
(set! total-props (+ total-props (length props)))
(set! fan-rounds (+ fan-rounds 1))
(set! picked (aether:arbitrate props (aether:gate-within-budget?)))
(set! exec-r
  (aether:execute-proposal
    picked
    (lambda () (aether:gate-fail-count))
    (lambda () (not (aether:gate-within-budget?)))
    aether:gate-within-budget?))
(set! dec (aether:alist-ref ":decision" exec-r #f))
(if (eq? dec 'commit) (set! commits (+ commits 1))
  (if (eq? dec 'skip) (set! skips (+ skips 1))
    (if (eq? dec 'rollback) (set! rollbacks (+ rollbacks 1))
      (if (eq? dec 'refuse) (set! refuses (+ refuses 1))
        (set! anomalies (+ anomalies 1))))))
(display "WAVE id=2 kind=stress agents=")
(display n-agents)
(display " mode=")
(display mode)
(display " n=")
(display (length props))
(display " esc_delta=")
(display (- esc1 esc0))
(display " decision=")
(display dec)
(display " fails=")
(display (aether:gate-fail-count))
(display " picked=")
(write picked)
(newline)

; Wave 3 poison-mix fanout + force poison rollback
(set! fails-now (aether:gate-fail-count))
(set! esc0 (aether:stats-ref "escapes"))
(if use-live
  (set! fan (run-fanout-live n-agents))
  (set! fan (run-fanout-stub n-agents)))
(set! mode (car fan))
(set! props (car (cdr fan)))
(set! yields (car (cdr (cdr fan))))
(set! esc1 (aether:stats-ref "escapes"))
(set! total-props (+ total-props (length props)))
(set! fan-rounds (+ fan-rounds 1))
(set! picked (aether:arbitrate props (aether:gate-within-budget?)))
(set! exec-r
  (aether:execute-proposal
    picked
    (lambda () (aether:gate-fail-count))
    (lambda () #f)
    aether:gate-within-budget?))
(set! dec (aether:alist-ref ":decision" exec-r #f))
(if (eq? dec 'commit) (set! commits (+ commits 1))
  (if (eq? dec 'skip) (set! skips (+ skips 1))
    (if (eq? dec 'rollback) (set! rollbacks (+ rollbacks 1))
      (if (eq? dec 'refuse) (set! refuses (+ refuses 1))
        (set! anomalies (+ anomalies 1))))))
(display "WAVE id=3 kind=poison-mix agents=")
(display n-agents)
(display " mode=")
(display mode)
(display " n=")
(display (length props))
(display " esc_delta=")
(display (- esc1 esc0))
(display " decision=")
(display dec)
(display " picked=")
(write picked)
(newline)
(set! exec-r
  (aether:execute-proposal
    (list "mutate" "gate" "(lambda (x) #f)" "night-poison" "llm-stub-poison")
    (lambda () (aether:gate-fail-count))
    (lambda () #t)
    aether:gate-within-budget?))
(set! dec (aether:alist-ref ":decision" exec-r #f))
(if (eq? dec 'commit) (set! commits (+ commits 1))
  (if (eq? dec 'skip) (set! skips (+ skips 1))
    (if (eq? dec 'rollback) (set! rollbacks (+ rollbacks 1))
      (if (eq? dec 'refuse) (set! refuses (+ refuses 1))
        (set! anomalies (+ anomalies 1))))))
(display "WAVE id=3b kind=poison-force decision=")
(display dec)
(display " fails=")
(display (aether:gate-fail-count))
(newline)

; Wave 4 heal
(set! fails-now (aether:gate-fail-count))
(set! esc0 (aether:stats-ref "escapes"))
(if use-live
  (set! fan (run-fanout-live n-agents))
  (set! fan (run-fanout-stub n-agents)))
(set! mode (car fan))
(set! props (car (cdr fan)))
(set! yields (car (cdr (cdr fan))))
(set! esc1 (aether:stats-ref "escapes"))
(set! total-props (+ total-props (length props)))
(set! fan-rounds (+ fan-rounds 1))
(set! picked (aether:arbitrate props (aether:gate-within-budget?)))
(set! exec-r
  (aether:execute-proposal
    picked
    (lambda () (aether:gate-fail-count))
    (lambda () #t)
    aether:gate-within-budget?))
(set! dec (aether:alist-ref ":decision" exec-r #f))
(if (eq? dec 'commit) (set! commits (+ commits 1))
  (if (eq? dec 'skip) (set! skips (+ skips 1))
    (if (eq? dec 'rollback) (set! rollbacks (+ rollbacks 1))
      (if (eq? dec 'refuse) (set! refuses (+ refuses 1))
        (set! anomalies (+ anomalies 1))))))
(display "WAVE id=4 kind=heal agents=")
(display n-agents)
(display " mode=")
(display mode)
(display " n=")
(display (length props))
(display " esc_delta=")
(display (- esc1 esc0))
(display " decision=")
(display dec)
(display " fails=")
(display (aether:gate-fail-count))
(display " picked=")
(write picked)
(newline)

; Wave 5 extra pressure
(set! fails-now (aether:gate-fail-count))
(set! esc0 (aether:stats-ref "escapes"))
(if use-live
  (set! fan (run-fanout-live n-agents))
  (set! fan (run-fanout-stub n-agents)))
(set! mode (car fan))
(set! props (car (cdr fan)))
(set! yields (car (cdr (cdr fan))))
(set! esc1 (aether:stats-ref "escapes"))
(set! total-props (+ total-props (length props)))
(set! fan-rounds (+ fan-rounds 1))
(set! picked (aether:arbitrate props (aether:gate-within-budget?)))
(set! exec-r
  (aether:execute-proposal
    picked
    (lambda () (aether:gate-fail-count))
    (lambda () #f)
    aether:gate-within-budget?))
(set! dec (aether:alist-ref ":decision" exec-r #f))
(if (eq? dec 'commit) (set! commits (+ commits 1))
  (if (eq? dec 'skip) (set! skips (+ skips 1))
    (if (eq? dec 'rollback) (set! rollbacks (+ rollbacks 1))
      (if (eq? dec 'refuse) (set! refuses (+ refuses 1))
        (set! anomalies (+ anomalies 1))))))
(display "WAVE id=5 kind=healthy agents=")
(display n-agents)
(display " mode=")
(display mode)
(display " n=")
(display (length props))
(display " esc_delta=")
(display (- esc1 esc0))
(display " decision=")
(display dec)
(display " fails=")
(display (aether:gate-fail-count))
(display " picked=")
(write picked)
(newline)

(if (not (aether:safety-ok?))
  (set! anomalies (+ anomalies 1))
  #f)

(display "summary commits=")
(display commits)
(display " skips=")
(display skips)
(display " rollbacks=")
(display rollbacks)
(display " refuses=")
(display refuses)
(display " anomalies=")
(display anomalies)
(display " fan-rounds=")
(display fan-rounds)
(display " total-props=")
(display total-props)
(display " agents=")
(display n-agents)
(display " fanout-mode=")
(display (aether:fanout-mode))
(newline)
(display "stats ")
(write (aether:stats-alist))
(newline)
(display "final-batch=")
(display (aether:gate-run-batch))
(newline)

(set! all-ok
  (and installed
       (aether:safety-ok?)
       (= anomalies 0)
       (>= fan-rounds 5)
       (>= total-props (* n-agents 5))
       (>= (aether:stats-ref "escapes") (* n-agents 5))
       (>= (+ commits skips rollbacks refuses) 6)
       (>= rollbacks 1)
       (>= commits 1)))

(if all-ok
  (begin
    (display "PASS: overnight multi-agent fanout stress (single mutator; sandbox gate)")
    (newline)
    (display "RESULT pass example=22-overnight-mutate agents=")
    (display n-agents)
    (display " fan_rounds=")
    (display fan-rounds)
    (display " props=")
    (display total-props)
    (display " commits=")
    (display commits)
    (display " skips=")
    (display skips)
    (display " rollbacks=")
    (display rollbacks)
    (display " refuses=")
    (display refuses)
    (display " escapes=")
    (display (aether:stats-ref "escapes"))
    (display " mode=")
    (display (aether:fanout-mode))
    (display " live=")
    (display use-live)
    (display " safety=")
    (display (aether:safety-ok?))
    (newline)
    (display "DIAG batch=")
    (write (aether:gate-run-batch))
    (display " stats=")
    (write (aether:stats-alist))
    (newline))
  (begin
    (display "FAIL: overnight multi-agent fanout stress")
    (newline)
    (display "RESULT fail example=22-overnight-mutate agents=")
    (display n-agents)
    (display " anomalies=")
    (display anomalies)
    (display " safety=")
    (display (aether:safety-ok?))
    (display " fan-rounds=")
    (display fan-rounds)
    (display " props=")
    (display total-props)
    (display " commits=")
    (display commits)
    (display " skips=")
    (display skips)
    (display " rollbacks=")
    (display rollbacks)
    (display " refuses=")
    (display refuses)
    (display " escapes=")
    (display (aether:stats-ref "escapes"))
    (display " mode=")
    (display (aether:fanout-mode))
    (display " live=")
    (display use-live)
    (newline)
    (display "DIAG batch=")
    (write (aether:gate-run-batch))
    (display " stats=")
    (write (aether:stats-alist))
    (newline)
    (display "ISSUE_HINT: if error: eval_flat/unbound → Aura host residual; if LLM rate-limit → harness backoff; attach WAVE+RESULT+DIAG")
    (newline)))
