(newline)
(display "WAVE id=2 kind=stress mode=")
(display mode)
(display " n=")
(display (length props))
(display " esc_delta=")
(display (- esc1 esc0))
(display " decision=")
(display dec)
(display " fails=")
(display (aether:gate-fail-count))
(display " picked=")
