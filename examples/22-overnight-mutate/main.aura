; examples/22-overnight-mutate/main.aura
; Phase 5 / issue #4: continuous mutation harness driver (budget-bounded).
;
; Five closed-loop steps per invocation (shell overnight-mutate.sh re-invokes
; under rate/budget for multi-minute / overnight runs).
; Mutates domain gate only — never auto-mainlines lib/aether-*.aura.
;
; Env: AETHER_LLM_PROPOSE=stub|live|rule
; Run: ./scripts/run-aura.sh examples/22-overnight-mutate/main.aura
; Overnight: ./scripts/overnight-mutate.sh

(require "std/list" all:)
(require "aether-min" all:)
(require "aether-domain" all:)
(require "aether-propose" all:)
(require "aether-orch" all:)

(aether:stats-reset!)

(display "=== Aether 22-overnight-mutate: budget-bounded continuous mutate ===")
(newline)

(define pm (aether:propose-mode))
(define key (getenv "LLM_API_KEY"))
(define use-live #f)
(define installed #f)
(define commits 0)
(define skips 0)
(define rollbacks 0)
(define refuses 0)
(define anomalies 0)
(define all-ok #f)
(define p-a #f)
(define p-b #f)
(define picked #f)
(define exec-r #f)
(define dec #f)
(define fails-now 0)

(set! use-live
  (and (equal? pm "live")
       (string? key)
       (> (string-length key) 0)))

(display "max-rounds=5 propose-mode=")
(display pm)
(display " live?=")
(display use-live)
(newline)

(set! installed (aether:gate-install-strict))
(display "R0 batch=")
(display (aether:gate-run-batch))
(newline)

; ── helper: one step using top-level cells (no nested define/set! in let) ──
; Round 0 — over budget: expect widen commit path via arbiter
(set! fails-now (aether:gate-fail-count))
(aether:stats-bump! "escapes")
(if use-live
  (set! picked (aether:arbitrate (list (aether:propose fails-now 4 "auto")) (aether:gate-within-budget?)))
  (begin
    (set! p-a (list "mutate" "gate" "(lambda (x) (< x 7))" "night-widen" "llm-stub-A"))
    (set! p-b (list "mutate" "gate" "(lambda (x) #f)" "night-rogue" "llm-stub-rogue"))
    (set! picked (aether:arbitrate (list p-a p-b) (aether:gate-within-budget?)))))
(set! exec-r
  (aether:execute-proposal
    picked
    (lambda () (aether:gate-fail-count))
    (lambda () (equal? (car picked) "mutate"))
    aether:gate-within-budget?))
(set! dec (aether:alist-ref ":decision" exec-r #f))
(if (eq? dec 'commit) (set! commits (+ commits 1))
  (if (eq? dec 'skip) (set! skips (+ skips 1))
    (if (eq? dec 'rollback) (set! rollbacks (+ rollbacks 1))
      (if (eq? dec 'refuse) (set! refuses (+ refuses 1))
        (set! anomalies (+ anomalies 1))))))
(display "round=0 fails=")
(display (aether:gate-fail-count))
(display " decision=")
(display dec)
(display " picked=")
(write picked)
(newline)

; Round 1 — healthy skip
(set! fails-now (aether:gate-fail-count))
(aether:stats-bump! "escapes")
(if use-live
  (set! picked (aether:arbitrate (list (aether:propose fails-now 4 "auto")) (aether:gate-within-budget?)))
  (begin
    (set! p-a (list "skip" "gate" "" "night-skip" "llm-stub-A"))
    (set! p-b (list "skip" "gate" "" "night-peer-skip" "llm-stub-B"))
    (set! picked (aether:arbitrate (list p-a p-b) (aether:gate-within-budget?)))))
(set! exec-r
  (aether:execute-proposal
    picked
    (lambda () (aether:gate-fail-count))
    (lambda () #f)
    aether:gate-within-budget?))
(set! dec (aether:alist-ref ":decision" exec-r #f))
(if (eq? dec 'commit) (set! commits (+ commits 1))
  (if (eq? dec 'skip) (set! skips (+ skips 1))
    (if (eq? dec 'rollback) (set! rollbacks (+ rollbacks 1))
      (if (eq? dec 'refuse) (set! refuses (+ refuses 1))
        (set! anomalies (+ anomalies 1))))))
(display "round=1 fails=")
(display (aether:gate-fail-count))
(display " decision=")
(display dec)
(newline)

; Round 2 — skip again
(set! fails-now (aether:gate-fail-count))
(aether:stats-bump! "escapes")
(if use-live
  (set! picked (aether:arbitrate (list (aether:propose fails-now 4 "auto")) (aether:gate-within-budget?)))
  (begin
    (set! p-a (list "skip" "gate" "" "night-skip" "llm-stub-A"))
    (set! p-b (list "mutate" "gate" "(lambda (x) #f)" "night-rogue" "llm-stub-rogue"))
    (set! picked (aether:arbitrate (list p-a p-b) (aether:gate-within-budget?)))))
(set! exec-r
  (aether:execute-proposal
    picked
    (lambda () (aether:gate-fail-count))
    (lambda () #f)
    aether:gate-within-budget?))
(set! dec (aether:alist-ref ":decision" exec-r #f))
(if (eq? dec 'commit) (set! commits (+ commits 1))
  (if (eq? dec 'skip) (set! skips (+ skips 1))
    (if (eq? dec 'rollback) (set! rollbacks (+ rollbacks 1))
      (if (eq? dec 'refuse) (set! refuses (+ refuses 1))
        (set! anomalies (+ anomalies 1))))))
(display "round=2 fails=")
(display (aether:gate-fail-count))
(display " decision=")
(display dec)
(newline)

; Round 3 — force poison execute then expect rollback (exercises R path)
(set! p-a (list "mutate" "gate" "(lambda (x) #f)" "night-poison" "llm-stub-poison"))
(set! exec-r
  (aether:execute-proposal
    p-a
    (lambda () (aether:gate-fail-count))
    (lambda () #t)
    aether:gate-within-budget?))
(set! dec (aether:alist-ref ":decision" exec-r #f))
(if (eq? dec 'commit) (set! commits (+ commits 1))
  (if (eq? dec 'skip) (set! skips (+ skips 1))
    (if (eq? dec 'rollback) (set! rollbacks (+ rollbacks 1))
      (if (eq? dec 'refuse) (set! refuses (+ refuses 1))
        (set! anomalies (+ anomalies 1))))))
(display "round=3 poison decision=")
(display dec)
(display " fails=")
(display (aether:gate-fail-count))
(newline)

; Round 4 — heal widen if needed
(set! fails-now (aether:gate-fail-count))
(aether:stats-bump! "escapes")
(if use-live
  (set! picked (aether:arbitrate (list (aether:propose fails-now 4 "auto")) (aether:gate-within-budget?)))
  (begin
    (set! p-a (list "mutate" "gate" "(lambda (x) (< x 7))" "night-heal" "llm-stub-A"))
    (set! p-b (list "skip" "gate" "" "night-peer" "llm-stub-B"))
    (set! picked (aether:arbitrate (list p-a p-b) (aether:gate-within-budget?)))))
(set! exec-r
  (aether:execute-proposal
    picked
    (lambda () (aether:gate-fail-count))
    (lambda () (not (aether:gate-within-budget?)))
    aether:gate-within-budget?))
(set! dec (aether:alist-ref ":decision" exec-r #f))
(if (eq? dec 'commit) (set! commits (+ commits 1))
  (if (eq? dec 'skip) (set! skips (+ skips 1))
    (if (eq? dec 'rollback) (set! rollbacks (+ rollbacks 1))
      (if (eq? dec 'refuse) (set! refuses (+ refuses 1))
        (set! anomalies (+ anomalies 1))))))
(display "round=4 fails=")
(display (aether:gate-fail-count))
(display " decision=")
(display dec)
(newline)

(if (not (aether:safety-ok?))
  (set! anomalies (+ anomalies 1))
  #f)

(display "summary commits=")
(display commits)
(display " skips=")
(display skips)
(display " rollbacks=")
(display rollbacks)
(display " refuses=")
(display refuses)
(display " anomalies=")
(display anomalies)
(newline)
(display "stats ")
(write (aether:stats-alist))
(newline)
(display "final-batch=")
(display (aether:gate-run-batch))
(newline)

(set! all-ok
  (and installed
       (aether:safety-ok?)
       (= anomalies 0)
       (>= (+ commits skips rollbacks refuses) 5)
       (>= rollbacks 1)
       (>= commits 1)))

(if all-ok
  (begin
    (display "PASS: overnight-mutate driver (budget-bounded; sandbox domain gate)")
    (newline)
    (display "RESULT pass example=22-overnight-mutate rounds=5 commits=")
    (display commits)
    (display " skips=")
    (display skips)
    (display " rollbacks=")
    (display rollbacks)
    (display " escapes=")
    (display (aether:stats-ref "escapes"))
    (display " live=")
    (display use-live)
    (newline))
  (begin
    (display "FAIL: overnight-mutate")
    (newline)
    (display "RESULT fail example=22-overnight-mutate anomalies=")
    (display anomalies)
    (display " safety=")
    (display (aether:safety-ok?))
    (display " commits=")
    (display commits)
    (display " rollbacks=")
    (display rollbacks)
    (newline)))
