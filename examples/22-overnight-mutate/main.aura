; examples/22-overnight-mutate/main.aura
; Phase 5 / issue #4: multi-agent sandbox fanout stress (overnight driver).
;
; Per invocation:
;   - 6 concurrent propose agents via aether:fanout (parallel-yield preferred)
;   - pure-Aura arbitrate → single executor
;   - 6 fanout waves for propose-edge pressure (LLM when live)
;   - forced poison rollback path
;
; Env: AETHER_LLM_PROPOSE=stub|live|rule
;      AETHER_OVERNIGHT_AGENTS=6|8  (default 6; 8 only when live pressure)
;
; Run: ./scripts/run-aura.sh examples/22-overnight-mutate/main.aura
; Overnight: ./scripts/overnight-mutate.sh

(require "std/list" all:)
(require "aether-min" all:)
(require "aether-domain" all:)
(require "aether-propose" all:)
(require "aether-orch" all:)

(aether:stats-reset!)

(display "=== Aether 22-overnight-mutate: multi-agent fanout stress ===")
(newline)
(display "LOG_META example=22-overnight-mutate role=overnight-driver denseness=phase5")
(newline)

; Pre-allocate all cells before install/rebind.
(define pm (aether:propose-mode))
(define key (getenv "LLM_API_KEY"))
(define use-live #f)
(define agents-env (getenv "AETHER_OVERNIGHT_AGENTS"))
(define n-agents 6)
(define installed #f)
(define commits 0)
(define skips 0)
(define rollbacks 0)
(define refuses 0)
(define anomalies 0)
(define fan-rounds 0)
(define total-props 0)
(define all-ok #f)
(define fails-now 0)
(define fan #f)
(define mode #f)
(define props #f)
(define yields #f)
(define picked #f)
(define exec-r #f)
(define dec #f)
(define esc0 0)
(define esc1 0)

(set! use-live
  (and (equal? pm "live")
       (string? key)
       (> (string-length key) 0)))

(if (and (string? agents-env) (equal? agents-env "8"))
  (set! n-agents 8)
  #f)
(if (and (string? agents-env) (equal? agents-env "4"))
  (set! n-agents 4)
  #f)

(display "n-agents=")
(display n-agents)
(display " propose-mode=")
(display pm)
(display " live?=")
(display use-live)
(display " fanout-mode(pre)=")
(display (aether:fanout-mode))
(newline)
(display "LOG_CFG agents=")
(display n-agents)
(display " live=")
(display use-live)
(display " propose_mode=")
(display pm)
(newline)

(set! installed (aether:gate-install-strict))
(display "R0 batch=")
(display (aether:gate-run-batch))
(display " fails=")
(display (aether:gate-fail-count))
(newline)

; ════════════════════════════════════════════════════════════
; Wave 0 — over budget: 6-agent fanout (live=LLM each; stub=mixed)
; ════════════════════════════════════════════════════════════
(set! fails-now (aether:gate-fail-count))
(set! esc0 (aether:stats-ref "escapes"))
(if use-live
  (set! fan
    (aether:fanout
      (list
        (lambda (f) (aether:stats-bump! "escapes") (aether:propose f 4 "auto"))
        (lambda (f) (aether:stats-bump! "escapes") (aether:propose f 4 "auto"))
        (lambda (f) (aether:stats-bump! "escapes") (aether:propose f 4 "auto"))
        (lambda (f) (aether:stats-bump! "escapes") (aether:propose f 4 "auto"))
        (lambda (f) (aether:stats-bump! "escapes") (aether:propose f 4 "auto"))
        (lambda (f) (aether:stats-bump! "escapes") (aether:propose f 4 "auto")))
      fails-now))
  (set! fan
    (aether:fanout-with-yield
      (list
        (lambda (f)
          (aether:stats-bump! "escapes")
          (if (> f 4)
            (list "mutate" "gate" "(lambda (x) (< x 7))" "w0-cons" "llm-stub-A")
            (list "skip" "gate" "" "w0-cons-s" "llm-stub-A")))
        (lambda (f)
          (aether:stats-bump! "escapes")
          (if (> f 3)
            (list "mutate" "gate" "(lambda (x) (< x 7))" "w0-agg" "llm-stub-B")
            (list "skip" "gate" "" "w0-agg-s" "llm-stub-B")))
        (lambda (f)
          (aether:stats-bump! "escapes")
          (if (> f 2)
            (list "mutate" "gate" "(lambda (x) (< x 7))" "w0-eager" "llm-stub-C")
            (list "skip" "gate" "" "w0-eager-s" "llm-stub-C")))
        (lambda (f)
          (aether:stats-bump! "escapes")
          (list "mutate" "gate" "(lambda (x) (< x 7))" "w0-force" "llm-stub-D"))
        (lambda (f)
          (aether:stats-bump! "escapes")
          (list "skip" "gate" "" "w0-peer" "llm-stub-E"))
        (lambda (f)
          (aether:stats-bump! "escapes")
          (list "mutate" "gate" "(lambda (x) #f)" "w0-rogue" "llm-stub-rogue")))
      fails-now)))
(set! mode (car fan))
(set! props (car (cdr fan)))
(set! yields (car (cdr (cdr fan))))
(set! esc1 (aether:stats-ref "escapes"))
(set! total-props (+ total-props (length props)))
(set! fan-rounds (+ fan-rounds 1))
(set! picked (aether:arbitrate props (aether:gate-within-budget?)))
(set! exec-r
  (aether:execute-proposal
    picked
    (lambda () (aether:gate-fail-count))
    (lambda () #t)
    aether:gate-within-budget?))
(set! dec (aether:alist-ref ":decision" exec-r #f))
(if (eq? dec 'commit) (set! commits (+ commits 1))
  (if (eq? dec 'skip) (set! skips (+ skips 1))
    (if (eq? dec 'rollback) (set! rollbacks (+ rollbacks 1))
      (if (eq? dec 'refuse) (set! refuses (+ refuses 1))
        (set! anomalies (+ anomalies 1))))))
(display "W0 mode=")
(display mode)
(display " n=")
(display (length props))
(display " yields=")
(display yields)
(display " esc+")
(display (- esc1 esc0))
(display " decision=")
(display dec)
(display " fails=")
(display (aether:gate-fail-count))
(newline)
(display "WAVE id=0 kind=stress mode=")
(display mode)
(display " n=")
(display (length props))
(display " yields=")
(display yields)
(display " esc_delta=")
(display (- esc1 esc0))
(display " decision=")
(display dec)
(display " fails=")
(display (aether:gate-fail-count))
(display " picked=")
(write picked)
(newline)


; ════════════════════════════════════════════════════════════
; Wave 1 — healthy multi-agent (skip-biased; live still N LLM calls)
; ════════════════════════════════════════════════════════════
(set! fails-now (aether:gate-fail-count))
(set! esc0 (aether:stats-ref "escapes"))
(if use-live
  (set! fan
    (aether:fanout
      (list
        (lambda (f) (aether:stats-bump! "escapes") (aether:propose f 4 "auto"))
        (lambda (f) (aether:stats-bump! "escapes") (aether:propose f 4 "auto"))
        (lambda (f) (aether:stats-bump! "escapes") (aether:propose f 4 "auto"))
        (lambda (f) (aether:stats-bump! "escapes") (aether:propose f 4 "auto"))
        (lambda (f) (aether:stats-bump! "escapes") (aether:propose f 4 "auto"))
        (lambda (f) (aether:stats-bump! "escapes") (aether:propose f 4 "auto")))
      fails-now))
  (set! fan
    (aether:fanout-with-yield
      (list
        (lambda (f)
          (aether:stats-bump! "escapes")
          (list "skip" "gate" "" "w1-a" "llm-stub-A"))
        (lambda (f)
          (aether:stats-bump! "escapes")
          (list "skip" "gate" "" "w1-b" "llm-stub-B"))
        (lambda (f)
          (aether:stats-bump! "escapes")
          (list "skip" "gate" "" "w1-c" "llm-stub-C"))
        (lambda (f)
          (aether:stats-bump! "escapes")
          (if (> f 4)
            (list "mutate" "gate" "(lambda (x) (< x 7))" "w1-d" "llm-stub-D")
            (list "skip" "gate" "" "w1-d-s" "llm-stub-D")))
        (lambda (f)
          (aether:stats-bump! "escapes")
          (list "skip" "gate" "" "w1-e" "llm-stub-E"))
        (lambda (f)
          (aether:stats-bump! "escapes")
          (list "mutate" "gate" "(lambda (x) #f)" "w1-rogue" "llm-stub-rogue")))
      fails-now)))
(set! mode (car fan))
(set! props (car (cdr fan)))
(set! yields (car (cdr (cdr fan))))
(set! esc1 (aether:stats-ref "escapes"))
(set! total-props (+ total-props (length props)))
(set! fan-rounds (+ fan-rounds 1))
(set! picked (aether:arbitrate props (aether:gate-within-budget?)))
(set! exec-r
  (aether:execute-proposal
    picked
    (lambda () (aether:gate-fail-count))
    (lambda () #f)
    aether:gate-within-budget?))
(set! dec (aether:alist-ref ":decision" exec-r #f))
(if (eq? dec 'commit) (set! commits (+ commits 1))
  (if (eq? dec 'skip) (set! skips (+ skips 1))
    (if (eq? dec 'rollback) (set! rollbacks (+ rollbacks 1))
      (if (eq? dec 'refuse) (set! refuses (+ refuses 1))
        (set! anomalies (+ anomalies 1))))))
(display "W1 mode=")
(display mode)
(display " n=")
(display (length props))
(display " esc+")
(display (- esc1 esc0))
(display " decision=")
(display dec)
(newline)
(display "WAVE id=1 kind=healthy mode=")
(display mode)
(display " n=")
(display (length props))
(display " esc_delta=")
(display (- esc1 esc0))
(display " decision=")
(display dec)
(display " fails=")
(display (aether:gate-fail-count))
(display " picked=")
(write picked)
(newline)


; ════════════════════════════════════════════════════════════
