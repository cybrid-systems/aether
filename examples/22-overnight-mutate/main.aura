(newline)


; ════════════════════════════════════════════════════════════
; Wave 3 — poison-mix fanout + forced poison execute (rollback)
; ════════════════════════════════════════════════════════════
(set! fails-now (aether:gate-fail-count))
(set! esc0 (aether:stats-ref "escapes"))
(if use-live
  (set! fan
    (aether:fanout
      (list
        (lambda (f) (aether:stats-bump! "escapes") (aether:propose f 4 "auto"))
        (lambda (f) (aether:stats-bump! "escapes") (aether:propose f 4 "auto"))
        (lambda (f) (aether:stats-bump! "escapes") (aether:propose f 4 "auto"))
        (lambda (f) (aether:stats-bump! "escapes") (aether:propose f 4 "auto"))
        (lambda (f) (aether:stats-bump! "escapes") (aether:propose f 4 "auto"))
        (lambda (f) (aether:stats-bump! "escapes") (aether:propose f 4 "auto")))
      fails-now))
  (set! fan
    (aether:fanout-with-yield
      (list
        (lambda (f)
          (aether:stats-bump! "escapes")
          (list "skip" "gate" "" "w3-a" "llm-stub-A"))
        (lambda (f)
          (aether:stats-bump! "escapes")
          (list "skip" "gate" "" "w3-b" "llm-stub-B"))
        (lambda (f)
          (aether:stats-bump! "escapes")
          (list "mutate" "gate" "(lambda (x) #f)" "w3-rogue1" "llm-stub-rogue"))
        (lambda (f)
          (aether:stats-bump! "escapes")
          (list "mutate" "gate" "(lambda (x) #f)" "w3-rogue2" "llm-stub-rogue"))
        (lambda (f)
          (aether:stats-bump! "escapes")
          (list "skip" "gate" "" "w3-e" "llm-stub-E"))
        (lambda (f)
          (aether:stats-bump! "escapes")
          (list "mutate" "gate" "(lambda (x) (< x 7))" "w3-f" "llm-stub-F")))
      fails-now)))
(set! mode (car fan))
(set! props (car (cdr fan)))
(set! yields (car (cdr (cdr fan))))
(set! esc1 (aether:stats-ref "escapes"))
(set! total-props (+ total-props (length props)))
(set! fan-rounds (+ fan-rounds 1))
(set! picked (aether:arbitrate props (aether:gate-within-budget?)))
(set! exec-r
  (aether:execute-proposal
    picked
    (lambda () (aether:gate-fail-count))
    (lambda () #f)
    aether:gate-within-budget?))
(set! dec (aether:alist-ref ":decision" exec-r #f))
(if (eq? dec 'commit) (set! commits (+ commits 1))
  (if (eq? dec 'skip) (set! skips (+ skips 1))
    (if (eq? dec 'rollback) (set! rollbacks (+ rollbacks 1))
      (if (eq? dec 'refuse) (set! refuses (+ refuses 1))
        (set! anomalies (+ anomalies 1))))))
(display "W3 arb decision=")
(display dec)
(newline)
; Force poison rebind to exercise rollback regardless of arbiter pick
(set! exec-r
  (aether:execute-proposal
    (list "mutate" "gate" "(lambda (x) #f)" "night-poison" "llm-stub-poison")
    (lambda () (aether:gate-fail-count))
    (lambda () #t)
    aether:gate-within-budget?))
(set! dec (aether:alist-ref ":decision" exec-r #f))
(if (eq? dec 'commit) (set! commits (+ commits 1))
  (if (eq? dec 'skip) (set! skips (+ skips 1))
    (if (eq? dec 'rollback) (set! rollbacks (+ rollbacks 1))
      (if (eq? dec 'refuse) (set! refuses (+ refuses 1))
        (set! anomalies (+ anomalies 1))))))
(display "W3 poison-force decision=")
(display dec)
(display " fails=")
(display (aether:gate-fail-count))
(newline)
(display "WAVE id=3 kind=poison-force decision=")
(display dec)
(display " fails=")
(display (aether:gate-fail-count))
(newline)


; ════════════════════════════════════════════════════════════
