  (aether:execute-proposal
    picked
    (lambda () (aether:gate-fail-count))
    (lambda () #f)
    aether:gate-within-budget?))
(set! dec (aether:alist-ref ":decision" exec-r #f))
(if (eq? dec 'commit) (set! commits (+ commits 1))
  (if (eq? dec 'skip) (set! skips (+ skips 1))
    (if (eq? dec 'rollback) (set! rollbacks (+ rollbacks 1))
      (if (eq? dec 'refuse) (set! refuses (+ refuses 1))
        (set! anomalies (+ anomalies 1))))))
(display "W5 mode=")
(display mode)
(display " n=")
(display (length props))
(display " esc+")
(display (- esc1 esc0))
(display " decision=")
(display dec)
(newline)
(display "WAVE id=5 kind=healthy mode=")
(display mode)
(display " n=")
(display (length props))
(display " esc_delta=")
(display (- esc1 esc0))
(display " decision=")
(display dec)
(display " fails=")
(display (aether:gate-fail-count))
(display " picked=")
(write picked)
(newline)


(if (not (aether:safety-ok?))
  (set! anomalies (+ anomalies 1))
  #f)

(display "summary commits=")
(display commits)
(display " skips=")
(display skips)
(display " rollbacks=")
(display rollbacks)
(display " refuses=")
(display refuses)
(display " anomalies=")
(display anomalies)
(display " fan-rounds=")
(display fan-rounds)
(display " total-props=")
(display total-props)
(display " fanout-mode=")
(display (aether:fanout-mode))
(newline)
(display "stats ")
(write (aether:stats-alist))
(newline)
(display "final-batch=")
(display (aether:gate-run-batch))
(newline)

; 6 agents × 6 waves = 36 proposals; live ≈ 36 LLM calls / invocation
(set! all-ok
  (and installed
       (aether:safety-ok?)
       (= anomalies 0)
       (>= fan-rounds 6)
       (>= total-props 30)
       (>= (aether:stats-ref "escapes") 30)
       (>= (+ commits skips rollbacks refuses) 7)
       (>= rollbacks 1)
       (>= commits 1)))

(if all-ok
  (begin
    (display "PASS: overnight multi-agent fanout stress (single mutator; sandbox gate)")
    (newline)
    (display "RESULT pass example=22-overnight-mutate agents=6 fan_rounds=")
    (display fan-rounds)
    (display " props=")
    (display total-props)
    (display " commits=")
    (display commits)
    (display " skips=")
    (display skips)
    (display " rollbacks=")
    (display rollbacks)
    (display " refuses=")
    (display refuses)
    (display " escapes=")
    (display (aether:stats-ref "escapes"))
    (display " mode=")
    (display (aether:fanout-mode))
    (display " live=")
    (display use-live)
    (display " safety=")
    (display (aether:safety-ok?))
    (newline)
    (display "DIAG batch=")
    (write (aether:gate-run-batch))
    (display " stats=")
    (write (aether:stats-alist))
    (newline))
  (begin
    (display "FAIL: overnight multi-agent fanout stress")
    (newline)
    (display "RESULT fail example=22-overnight-mutate anomalies=")
    (display anomalies)
    (display " safety=")
    (display (aether:safety-ok?))
    (display " fan-rounds=")
    (display fan-rounds)
    (display " props=")
    (display total-props)
    (display " commits=")
    (display commits)
    (display " skips=")
    (display skips)
    (display " rollbacks=")
    (display rollbacks)
    (display " refuses=")
    (display refuses)
    (display " escapes=")
    (display (aether:stats-ref "escapes"))
    (display " mode=")
    (display (aether:fanout-mode))
    (display " live=")
    (display use-live)
    (newline)
    (display "DIAG batch=")
    (write (aether:gate-run-batch))
    (display " stats=")
    (write (aether:stats-alist))
    (newline)
    (display "ISSUE_HINT: if error: eval_flat/unbound → Aura host residual; if unexpected refuse on stub → denseness/driver; attach WAVE+RESULT+DIAG")
    (newline)))
