            (list "skip" "gate" "" "w2-a-s" "llm-stub-A")))
        (lambda (f)
          (aether:stats-bump! "escapes")
          (if (> f 3)
            (list "mutate" "gate" "(lambda (x) (< x 7))" "w2-b" "llm-stub-B")
            (list "skip" "gate" "" "w2-b-s" "llm-stub-B")))
        (lambda (f)
          (aether:stats-bump! "escapes")
          (list "mutate" "gate" "(lambda (x) (< x 7))" "w2-c" "llm-stub-C"))
        (lambda (f)
          (aether:stats-bump! "escapes")
          (list "skip" "gate" "" "w2-d" "llm-stub-D"))
        (lambda (f)
          (aether:stats-bump! "escapes")
          (list "skip" "gate" "" "w2-e" "llm-stub-E"))
        (lambda (f)
