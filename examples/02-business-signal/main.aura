; examples/02-business-signal/main.aura
;
; Business-signal denseness probe (fail-count budget) via aether-domain.
;
; Run: ./scripts/run-aura.sh examples/02-business-signal/main.aura

(require "std/list" all:)
(require "aether-min" all:)
(require "aether-domain" all:)

(aether:stats-reset!)

(display "=== Aether 02-business-signal: fail-rate driven closed loop ===")
(newline)

(define installed (aether:gate-install-strict))

(display "installed=")
(display installed)
(display " gate=")
(display (list (gate 3) (gate 4) (gate 7)))
(newline)

(display "R0 batch=")
(display (aether:gate-run-batch))
(display " fails=")
(display (aether:gate-fail-count))
(display " over-budget?=")
(display (not (aether:gate-within-budget?)))
(newline)

(define r1 #f)
(define r2 #f)
(define r3 #f)

; R1: over budget → widen
(set! r1
  (aether:loop-once
    (lambda () (aether:gate-fail-count))
    (lambda () (not (aether:gate-within-budget?)))
    "gate"
    aether:gate-body-widen
    "r1-widen-gate"
    aether:gate-within-budget?))
(display "R1 ")
(write r1)
(newline)
(display "R1 batch=")
(display (aether:gate-run-batch))
(newline)

; R2: skip
(set! r2
  (aether:loop-once
    (lambda () (aether:gate-fail-count))
    (lambda () (not (aether:gate-within-budget?)))
    "gate"
    aether:gate-body-widen
    "r2-noop"
    aether:gate-within-budget?))
(display "R2 ")
(write r2)
(newline)

; R3: bad deny → rollback
(set! r3
  (aether:loop-once
    (lambda () (aether:gate-fail-count))
    (lambda () #t)
    "gate"
    aether:gate-body-deny
    "r3-deny-all"
    aether:gate-within-budget?))
(display "R3 ")
(write r3)
(newline)
(display "R3 batch=")
(display (aether:gate-run-batch))
(newline)

(display "stats ")
(write (aether:stats-alist))
(newline)

(define all-ok
  (and installed
       (eq? (aether:alist-ref ":decision" r1 #f) 'commit)
       (eq? (aether:alist-ref ":decision" r2 #f) 'skip)
       (eq? (aether:alist-ref ":decision" r3 #f) 'rollback)
       (aether:gate-within-budget?)
       (= (aether:gate-fail-count) 4)
       (= (aether:stats-ref "commits") 1)
       (>= (aether:stats-ref "rollbacks") 1)
       (>= (aether:stats-ref "decide-skip") 1)
       (= (aether:stats-ref "rounds") 3)
       (aether:safety-ok?)
       (= (aether:stats-ref "escapes") 0)))

(if all-ok
  (begin
    (display "PASS: business-signal loop (fail-rate decide + commit/skip/rollback)")
    (newline)
    (display "escapes: 0 in evolvable core (pure Aura + aether-min)")
    (newline)
    (display "RESULT pass example=02-business-signal escapes=0 commits=1 rollbacks=1")
    (newline))
  (begin
    (display "FAIL")
    (newline)
    (display "RESULT fail example=02-business-signal")
    (newline)))
