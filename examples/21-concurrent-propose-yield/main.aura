; examples/21-concurrent-propose-yield/main.aura
; Phase 5 / issue #2: concurrent propose fanout + yield + single mutator.
;
; Complements 20 (multi live + arbiter): here stress is fanout + yield safety
; so mutation stays serialized and rollback-consistent under stub/live edge.
;
; Offline: stub proposers inside fanout-with-yield.
; Live: AETHER_LLM_PROPOSE=live (each fanout worker may call aether:propose).
;
; Run: ./scripts/run-aura.sh examples/21-concurrent-propose-yield/main.aura

(require "std/list" all:)
(require "aether-min" all:)
(require "aether-domain" all:)
(require "aether-propose" all:)
(require "aether-orch" all:)

(aether:stats-reset!)

(display "=== Aether 21-concurrent-propose-yield: fanout + yield + single mutator ===")
(newline)

(define installed #f)
(define pm #f)
(define key #f)
(define live? #f)
(define fan #f)
(define mode #f)
(define props #f)
(define yields #f)
(define picked #f)
(define exec-r #f)
(define fails-now 0)
(define a-ok #f)
(define b-ok #f)
(define c-ok #f)
(define all-ok #f)
(define esc0 0)
(define esc1 0)
(define fails-before 0)

(set! pm (aether:propose-mode))
(set! key (getenv "LLM_API_KEY"))
(set! live?
  (and (equal? pm "live")
       (string? key)
       (> (string-length key) 0)))

(display "propose-mode=")
(display pm)
(display " live?=")
(display live?)
(display " fanout-mode(pre)=")
(display (aether:fanout-mode))
(newline)

(set! installed (aether:gate-install-strict))
(display "R0 batch=")
(display (aether:gate-run-batch))
(display " fails=")
(display (aether:gate-fail-count))
(newline)

; ── A: over budget — fanout 3 proposers + yield; arb + single commit ──
(set! fails-now (aether:gate-fail-count))
(set! esc0 (aether:stats-ref "escapes"))
(set! fan
  (aether:fanout-with-yield
    (list
      (lambda (f)
        (aether:stats-bump! "escapes")
        (if live?
          (aether:propose f 4 "auto")
          (if (> f 4)
            (list "mutate" "gate" "(lambda (x) (< x 7))" "cons-widen" "llm-stub-A")
            (list "skip" "gate" "" "cons-skip" "llm-stub-A"))))
      (lambda (f)
        (aether:stats-bump! "escapes")
        (if live?
          (aether:propose f 4 "auto")
          (if (> f 3)
            (list "mutate" "gate" "(lambda (x) (< x 7))" "agg-widen" "llm-stub-B")
            (list "skip" "gate" "" "agg-skip" "llm-stub-B"))))
      (lambda (f)
        (aether:stats-bump! "escapes")
        (if live?
          (aether:propose f 4 "auto")
          (list "mutate" "gate" "(lambda (x) #f)" "rogue-deny" "llm-stub-C"))))
    fails-now))
(set! mode (car fan))
(set! props (car (cdr fan)))
(set! yields (car (cdr (cdr fan))))
(set! esc1 (aether:stats-ref "escapes"))
(set! picked (aether:arbitrate props (aether:gate-within-budget?)))
(display "A mode=")
(display mode)
(display " yields=")
(display yields)
(display " esc+")
(display (- esc1 esc0))
(newline)
(display "A props=")
(write props)
(newline)
(display "A picked=")
(write picked)
(newline)
(set! exec-r
  (aether:execute-proposal
    picked
    (lambda () (aether:gate-fail-count))
    (lambda () #t)
    aether:gate-within-budget?))
(display "A exec=")
(write exec-r)
(newline)
(display "A batch=")
(display (aether:gate-run-batch))
(newline)
(set! a-ok
  (and (equal? mode "sequential-yield")
       (list? props)
       (= (length props) 3)
       (>= yields 6)
       (>= (- esc1 esc0) 3)
       (equal? (car picked) "mutate")
       (aether:proposal-widen? picked)
       (not (aether:proposal-deny? picked))
       (eq? (aether:alist-ref ":decision" exec-r #f) 'commit)
       (aether:gate-within-budget?)
       (aether:safety-ok?)))

; ── B: healthy fanout after rebind — arb prefers skip; single mutator path ──
(set! fails-now (aether:gate-fail-count))
(set! fan
  (aether:fanout-with-yield
    (list
      (lambda (f)
        (aether:stats-bump! "escapes")
        (if live?
          (aether:propose f 4 "auto")
          (if (> f 4)
            (list "mutate" "gate" "(lambda (x) (< x 7))" "cons-widen" "llm-stub-A")
            (list "skip" "gate" "" "cons-skip" "llm-stub-A"))))
      (lambda (f)
        (aether:stats-bump! "escapes")
        (if live?
          (aether:propose f 4 "auto")
          (if (> f 3)
            (list "mutate" "gate" "(lambda (x) (< x 7))" "agg-widen" "llm-stub-B")
            (list "skip" "gate" "" "agg-skip" "llm-stub-B")))))
    fails-now))
(set! mode (car fan))
(set! props (car (cdr fan)))
(set! yields (car (cdr (cdr fan))))
(set! picked (aether:arbitrate props (aether:gate-within-budget?)))
(display "B mode=")
(display mode)
(display " yields=")
(display yields)
(display " picked=")
(write picked)
(newline)
(set! exec-r
  (aether:execute-proposal
    picked
    (lambda () (aether:gate-fail-count))
    (lambda () #f)
    aether:gate-within-budget?))
(display "B exec=")
(write exec-r)
(newline)
(set! b-ok
  (and (equal? mode "sequential-yield")
       (= (length props) 2)
       (>= yields 4)
       (equal? (car picked) "skip")
       (eq? (aether:alist-ref ":decision" exec-r #f) 'skip)
       (aether:gate-within-budget?)
       (aether:safety-ok?)))

; ── C: poison fanout candidate + invalid body → refuse/rollback path ──
; Single mutator attempts deny body when force-need; verify fails → rollback.
(set! fails-before (aether:gate-fail-count))
(set! fan
  (aether:fanout-with-yield
    (list
      (lambda (f)
        (list "skip" "gate" "" "safe-skip" "llm-stub-A"))
      (lambda (f)
        (list "mutate" "gate" "(lambda (x) #f)" "poison-deny" "llm-stub-poison")))
    fails-before))
(set! props (car (cdr fan)))
(set! picked (aether:arbitrate props (aether:gate-within-budget?)))
; Arbiter should filter deny → skip. Force a bad execute of the poison to prove refuse/rollback path.
(set! exec-r
  (aether:execute-proposal
    (car (cdr props))
    (lambda () (aether:gate-fail-count))
    (lambda () #t)
    aether:gate-within-budget?))
(display "C arb-picked=")
(write picked)
(newline)
(display "C poison-exec=")
(write exec-r)
(newline)
(display "C fails-after=")
(display (aether:gate-fail-count))
(newline)
(set! c-ok
  (and (equal? (car picked) "skip")
       (not (aether:proposal-deny? picked))
       ; poison body either refuse (schema/deny detect) or rollback after verify
       (or (eq? (aether:alist-ref ":decision" exec-r #f) 'refuse)
           (eq? (aether:alist-ref ":decision" exec-r #f) 'rollback)
           ; if schema accepts deny lambda, verify should fail → rollback
           (not (eq? (aether:alist-ref ":decision" exec-r #f) 'commit)))
       (aether:safety-ok?)
       ; budget restored or still healthy relative to deny-all
       (<= (aether:gate-fail-count) 10)))

(display "stats ")
(write (aether:stats-alist))
(newline)

(set! all-ok
  (and installed
       a-ok b-ok c-ok
       (aether:safety-ok?)
       (>= (aether:stats-ref "escapes") 3)
       (>= (aether:stats-ref "commits") 1)))

(if all-ok
  (begin
    (display "PASS: concurrent propose fanout + yield + single mutator")
    (newline)
    (display "mode=sequential-yield; mutate only in executor; yield barriers hold")
    (newline)
    (display "RESULT pass example=21-concurrent-propose-yield live=")
    (display live?)
    (display " mode=")
    (display (aether:fanout-mode))
    (display " escapes=")
    (display (aether:stats-ref "escapes"))
    (newline))
  (begin
    (display "FAIL: concurrent-propose-yield")
    (newline)
    (display " a-ok=")
    (display a-ok)
    (display " b-ok=")
    (display b-ok)
    (display " c-ok=")
    (display c-ok)
    (newline)
    (display "RESULT fail example=21-concurrent-propose-yield escapes=")
    (display (aether:stats-ref "escapes"))
    (newline)))
