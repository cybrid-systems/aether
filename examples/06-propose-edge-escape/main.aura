; examples/06-propose-edge-escape/main.aura
; Meter propose-edge E (rule vs stub) with aether-domain.
; Run: ./scripts/run-aura.sh examples/06-propose-edge-escape/main.aura

(require "std/list" all:)
(require "aether-min" all:)
(require "aether-domain" all:)
(require "aether-propose" all:)

(aether:stats-reset!)

(display "=== Aether 06-propose-edge-escape: E metering on propose edge ===")
(newline)

(define installed (aether:gate-install-strict))

(define (executor-run proposal)
  (let ((kind (aether:proposal-kind proposal)))
    (if (equal? kind "skip")
      (aether:loop-once
        (lambda () (aether:gate-fail-count))
        (lambda () #f)
        "gate" aether:gate-body-widen "exec-skip" aether:gate-within-budget?)
      (aether:loop-once
        (lambda () (aether:gate-fail-count))
        (lambda () #t)
        (aether:proposal-name proposal)
        (aether:proposal-body proposal)
        (aether:proposal-summary proposal)
        aether:gate-within-budget?))))

(display "mode-default=")
(display (aether:propose-mode))
(newline)
(display "R0 batch=")
(display (aether:gate-run-batch))
(newline)

; A: rule E=0
(aether:stats-reset!)
(define p-rule #f)
(define r-rule #f)
(set! p-rule (aether:propose-rule (aether:gate-fail-count) 4 "auto"))
(display "A proposal=")
(write p-rule)
(display " source=")
(display (aether:proposal-source p-rule))
(display " escapes=")
(display (aether:stats-ref "escapes"))
(newline)
(set! r-rule (executor-run p-rule))
(display "A exec=")
(write r-rule)
(newline)
(display "A batch=")
(display (aether:gate-run-batch))
(display " escapes-after=")
(display (aether:stats-ref "escapes"))
(newline)

(define a-ok
  (and (equal? (aether:proposal-source p-rule) "rule")
       (eq? (aether:alist-ref ":decision" r-rule #f) 'commit)
       (aether:gate-within-budget?)
       (= (aether:stats-ref "escapes") 0)))

; B: stub E>=1
(aether:rebind-safe "gate" aether:gate-body-strict "reset-strict")
(aether:stats-reset!)
(define p-stub #f)
(define r-stub #f)
(aether:stats-bump! "escapes")
(set! p-stub
  (list "mutate" "gate" aether:gate-body-widen "llm-stub:auto-widen" "llm-stub"))
(display "B proposal=")
(write p-stub)
(display " source=")
(display (aether:proposal-source p-stub))
(display " escapes=")
(display (aether:stats-ref "escapes"))
(newline)
(set! r-stub (executor-run p-stub))
(display "B exec=")
(write r-stub)
(newline)
(display "B batch=")
(display (aether:gate-run-batch))
(display " escapes-after=")
(display (aether:stats-ref "escapes"))
(newline)

(define b-ok
  (and (equal? (aether:proposal-source p-stub) "llm-stub")
       (eq? (aether:alist-ref ":decision" r-stub #f) 'commit)
       (aether:gate-within-budget?)
       (>= (aether:stats-ref "escapes") 1)))

; C: bad stub → rollback
(aether:stats-reset!)
(aether:stats-bump! "escapes")
(define p-bad
  (list "mutate" "gate" aether:gate-body-deny "llm-stub:deny" "llm-stub"))
(define r-bad #f)
(set! r-bad (executor-run p-bad))
(display "C bad-propose exec=")
(write r-bad)
(newline)
(display "C batch (must stay healthy)=")
(display (aether:gate-run-batch))
(newline)

(define c-ok
  (and (eq? (aether:alist-ref ":decision" r-bad #f) 'rollback)
       (aether:gate-within-budget?)
       (= (aether:gate-fail-count) 4)
       (>= (aether:stats-ref "escapes") 1)))

(display "stats-final ")
(write (aether:stats-alist))
(newline)

(define all-ok
  (and installed a-ok b-ok c-ok (aether:safety-ok?)))

(if all-ok
  (begin
    (display "PASS: propose-edge E metering (rule E=0; stub E>=1; core still guarded)")
    (newline)
    (display "escape isolation: executor verify/rollback independent of propose source")
    (newline)
    (display "RESULT pass example=06-propose-edge-escape rule_escapes=0 stub_escapes=1")
    (newline))
  (begin
    (display "FAIL")
    (newline)
    (display "RESULT fail example=06-propose-edge-escape")
    (newline)))
