; examples/08-parse-proposal-wire/main.aura
; Wire parse → schema → exec (aether-domain).
; Run: ./scripts/run-aura.sh examples/08-parse-proposal-wire/main.aura

(require "std/list" all:)
(require "std/string" all:)
(require "aether-min" all:)
(require "aether-domain" all:)
(require "aether-propose" all:)

(aether:stats-reset!)

(display "=== Aether 08-parse-proposal-wire: text → schema → exec ===")
(newline)

(define installed (aether:gate-install-strict))

(display "R0 batch=")
(display (aether:gate-run-batch))
(newline)
(display "prompt-sample length=")
(display (string-length (aether:proposal-prompt 7 4)))
(newline)

(define llm-text-a
  "Sure, here is my suggestion:
MUTATE|gate|(lambda (x) (< x 7))|widen-from-llm
Thanks!")
(define p-a #f)
(define r-a #f)
(set! p-a (aether:parse-proposal-text llm-text-a "llm-sim"))
(display "A parsed=")
(write p-a)
(display " valid?=")
(display (aether:proposal-valid? p-a))
(newline)
(aether:stats-bump! "escapes")
(set! r-a
  (aether:execute-proposal
    p-a
    (lambda () (aether:gate-fail-count))
    (lambda () #t)
    aether:gate-within-budget?))
(display "A exec=")
(write r-a)
(newline)
(display "A batch=")
(display (aether:gate-run-batch))
(newline)

(define a-ok
  (and (pair? p-a)
       (aether:proposal-valid? p-a)
       (eq? (aether:alist-ref ":decision" r-a #f) 'commit)
       (aether:gate-within-budget?)
       (>= (aether:stats-ref "escapes") 1)))

(define p-b (aether:parse-proposal-text "just rewrite everything in python lol" "llm-sim"))
(display "B parsed=")
(write p-b)
(newline)
(define r-b #f)
(set! r-b
  (if p-b
    (aether:execute-proposal p-b
      (lambda () (aether:gate-fail-count)) (lambda () #t) aether:gate-within-budget?)
    (list (cons ":ok" #f)
          (cons ":decision" 'refuse)
          (cons ":reason" "parse-failed")
          (cons ":snap" -1))))
(display "B exec=")
(write r-b)
(newline)

(define b-ok
  (and (not p-b)
       (eq? (aether:alist-ref ":decision" r-b #f) 'refuse)
       (aether:gate-within-budget?)))

(define p-c
  (aether:parse-proposal-text "MUTATE|gate|rm -rf /|hack" "llm-sim"))
(display "C parsed=")
(write p-c)
(display " valid?=")
(display (if p-c (aether:proposal-valid? p-c) #f))
(newline)
(define r-c #f)
(set! r-c
  (if p-c
    (aether:execute-proposal p-c
      (lambda () (aether:gate-fail-count)) (lambda () #t) aether:gate-within-budget?)
    (list (cons ":ok" #f) (cons ":decision" 'refuse) (cons ":reason" "parse-failed"))))
(display "C exec=")
(write r-c)
(newline)

(define c-ok
  (and (pair? p-c)
       (not (aether:proposal-valid? p-c))
       (eq? (aether:alist-ref ":decision" r-c #f) 'refuse)
       (aether:gate-within-budget?)))

(define p-d
  (aether:parse-proposal-text "SKIP|gate||hold-steady" "llm-sim"))
(define r-d #f)
(set! r-d
  (aether:execute-proposal p-d
    (lambda () (aether:gate-fail-count))
    (lambda () #f)
    aether:gate-within-budget?))
(display "D skip exec=")
(write r-d)
(newline)

(define d-ok
  (and (aether:proposal-valid? p-d)
       (eq? (aether:alist-ref ":decision" r-d #f) 'skip)
       (aether:gate-within-budget?)
       (= (aether:gate-fail-count) 4)))

(display "stats ")
(write (aether:stats-alist))
(newline)

(define all-ok
  (and installed a-ok b-ok c-ok d-ok (aether:safety-ok?)))

(if all-ok
  (begin
    (display "PASS: wire parse → schema → exec (prose/garbage/illegal/skip)")
    (newline)
    (display "propose edge: structured text only; core still verify-gated")
    (newline)
    (display "RESULT pass example=08-parse-proposal-wire escapes=1")
    (newline))
  (begin
    (display "FAIL")
    (newline)
    (display "RESULT fail example=08-parse-proposal-wire")
    (newline)))
